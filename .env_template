# Copy to .env (git-ignored) and fill in. Loaded automatically by the CLI,
# chords-ui and splitter-ui; real environment variables take precedence.

# Only needed if you pick OpenRouter for transcription / lyric revision / the mix advisor.
OPENROUTER_API_KEY=

# Where the ACE-Step server for AI edits listens (make acestep). This is the default.
# ACESTEP_URL=http://127.0.0.1:8001
